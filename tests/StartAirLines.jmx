        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

def responseTime = prev.getTime()

// NOTE: comment removed (encoding issue)
def durationThreshold = 3000 

// NOTE: comment removed (encoding issue)
    def failureMessage = &quot;&quot;
    failureMessage += &quot;Response time exceeded threshold (${durationThreshold} ms). &quot;
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failureMessage)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>
        <hashTree/>
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// NOTE: comment removed (encoding issue)

// NOTE: comment removed (encoding issue)
if (!sampleResult.isSuccessful()) {
    // 檢查?�誤訊息?�否?�含?��??��??�斷言訊息
    // Duration Assertion ?�錯誤�??��?被設置為 FailureMessage
    def failureMessage = sampleResult.getAssertionResults().any { it.getFailureMessage().contains(&quot;The operation lasted too long&quot;) };

    if (failureMessage) {
        // 設�?統�??�錯誤�??��??�??        sampleResult.setResponseMessage(&quot;Total transaction time exceeded threshold.&quot;);
        sampleResult.setResponseCode(&quot;504&quot;); // 設�?一?�模?��?超�??�?�碼
    }
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>

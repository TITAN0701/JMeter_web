        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def sampleResult = prev
if (sampleResult == null) {
    return
}

def responseTime = sampleResult.getTime()
def durationThreshold = 3000

if (responseTime &gt; durationThreshold) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Response time exceeded threshold (${durationThreshold} ms). Actual: ${responseTime} ms.&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>
        <hashTree/>
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def sampleResult = prev

if (sampleResult == null) {
    return
}

if (!sampleResult.isSuccessful()) {
    def failureMessage = sampleResult.getAssertionResults()?.any { assertionResult -&gt;
        assertionResult?.getFailureMessage()?.contains(&quot;The operation lasted too long&quot;)
    } ?: false

    if (failureMessage) {
        sampleResult.setResponseMessage(&quot;Total transaction time exceeded threshold.&quot;)
        sampleResult.setResponseCode(&quot;504&quot;)
    }
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>
        <hashTree/>
      </hashTree>
    </hashTree>

    // 檢查?�誤訊息?�否?�含?��??��??�斷言訊息
    // Duration Assertion ?�錯誤�??��?被設置為 FailureMessage
    def failureMessage = sampleResult.getAssertionResults().any { it.getFailureMessage().contains(&quot;The operation lasted too long&quot;) };

    if (failureMessage) {

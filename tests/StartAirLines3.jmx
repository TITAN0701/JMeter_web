          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="main Request" enabled="true">
            <boolProp name="HTTPSampler.image_parser">true</boolProp>
            <stringProp name="HTTPSampler.domain">www.starlux-airlines.com</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/zh-TW</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.samplers.SampleResult

def prevResult = prev
if (prevResult == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Previous sample result is null&quot;)
    return
}

def subResults = prevResult.getSubResults()
if (subResults == null || subResults.length == 0) {
    return
}

def timeoutThresholdMs = 30000

def hasError = false
for (r in subResults) {
    if (r == null) { continue }
    if (!r.isSuccessful()) {
        hasError = true
        break
    }
    def t = r.getTime()
    if (t &gt; timeoutThresholdMs) {
        hasError = true
        break
    }
}

if (hasError) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Sub request failed or timed out&quot;)
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>

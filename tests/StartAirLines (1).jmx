      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">import groovy.json.JsonSlurper

def responseTime = prev.getTime()

// 设置 Duration Assertion 的阈值 (毫秒)
def durationThreshold = 3000 

// 验证字段和响应时间
if (responseTime &gt; durationThreshold) {
    def failureMessage = &quot;&quot;
    failureMessage += &quot;Response time exceeded threshold (${durationThreshold} ms). &quot;
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failureMessage)
}</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223Listener>
      <hashTree/>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">// 取得當前的樣本結果
def sampleResult = prev;

// 檢查樣本是否失敗
if (!sampleResult.isSuccessful()) {
    // 檢查錯誤訊息是否包含特定的超時斷言訊息
    // Duration Assertion 的錯誤訊息會被設置為 FailureMessage
    def failureMessage = sampleResult.getAssertionResults().any { it.getFailureMessage().contains(&quot;The operation lasted too long&quot;) };

    if (failureMessage) {
        // 設定統一的錯誤訊息和狀態
        sampleResult.setResponseMessage(&quot;Total transaction time exceeded threshold.&quot;);
        sampleResult.setResponseCode(&quot;504&quot;); // 設定一個模擬的超時狀態碼
    }
}</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223Listener>

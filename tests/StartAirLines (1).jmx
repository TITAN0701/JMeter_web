          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import java.net.URL;

// 創建一個新的整合結果的函數
def createAggregatedResult(url, startTime, endTime, samplerCount) {
    SampleResult aggregatedResult = new SampleResult()
    aggregatedResult.setURL(url)
    aggregatedResult.setStartTime(startTime)
    aggregatedResult.setEndTime(endTime)
    // 不直接設置時間，讓 JMeter 自動從 start 和 end time 計算
    aggregatedResult.setSampleCount(samplerCount)
    aggregatedResult.setSuccessful(true)
    // 設置其他必要的字段
    aggregatedResult.setResponseCode(&quot;200&quot;)
    aggregatedResult.setResponseMessage(&quot;OK&quot;)
    return aggregatedResult
}

// 定義主網域的關鍵字
def mainDomainKeyword = &quot;starlux-airlines&quot;

// 獲取主要請求信息
def mainDomain = prev.getURL().getHost()
def subResults = prev.getSubResults()

if (subResults.length &gt; 0) {
    // 初始化統計變數
    def sameDomainStartTime = Long.MAX_VALUE
    def sameDomainEndTime = 0L
    def sameDomainCount = 0

    def otherDomainStartTime = Long.MAX_VALUE
    def otherDomainEndTime = 0L
    def otherDomainCount = 0

    // 用於存儲子請求的列表
    def topSlowestRequests = new ArrayList&lt;SampleResult&gt;()

    // 分析所有子請求
    for (subResult in subResults) {
        def subDomain = subResult.getURL().getHost()
        def startTime = subResult.getStartTime()
        def endTime = subResult.getEndTime()
        def diff = endTime - startTime;

        // 將子請求添加到 topSlowestRequests 列表中
        topSlowestRequests.add(subResult)

        if (subDomain.contains(mainDomainKeyword)) {
            sameDomainCount++
            sameDomainStartTime = Math.min(sameDomainStartTime, startTime)
            sameDomainEndTime = (sameDomainEndTime ? sameDomainEndTime + diff : sameDomainStartTime + diff);
            // subResult.setSampleLabel(&quot;主站個別請求&quot;)
        } else {
            otherDomainCount++
            otherDomainStartTime = Math.min(otherDomainStartTime, startTime)
            otherDomainEndTime = (otherDomainEndTime ? otherDomainEndTime + diff : otherDomainStartTime + diff);
            // subResult.setSampleLabel(&quot;外部個別請求&quot;)
        }
    }

    // 對 topSlowestRequests 列表按照耗時進行排序
    topSlowestRequests.sort { a, b -&gt; b.getTime() - a.getTime() }

    // 移除所有原有的子請求
    prev.removeSubResults()

    // 照耗時排序子請求到結果
    for (int i = 0; i &lt; topSlowestRequests.size(); i++) {
        def slowestRequest = topSlowestRequests.get(i)
        log.info(slowestRequest.toString())
        slowestRequest.setSampleLabel(&quot;Top &quot; + (i + 1) + &quot; 耗時請求&quot;)
        log.info(slowestRequest.toString())
        prev.addSubResult(slowestRequest)
    }

    // 獲取所有子請求
	def newSubResults = prev.getSubResults()
	
    // 遍歷所有子請求並修改其標籤
	for (newsubResult in newSubResults) {
	    def newSubDomain = newsubResult.getURL().getHost()
        newsubResult.setSampleLabel(newSubDomain)
	}
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
